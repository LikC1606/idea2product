# Primary LLM provider: openai | anthropic | google (at least one key for the selected provider)
PRIMARY_LLM_PROVIDER=openai

# OpenAI API Configuration (used when PRIMARY_LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_VLM_MODEL=gpt-4o
MAX_TOKENS=4096
TEMPERATURE=0.7

# Anthropic (Claude) – used when PRIMARY_LLM_PROVIDER=anthropic; OpenAI-compatible endpoint e.g. OpenRouter
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_MODEL=anthropic/claude-3-5-sonnet-20241022

# Google (Gemini) – used when PRIMARY_LLM_PROVIDER=google; OpenAI-compatible endpoint e.g. OpenRouter
# GOOGLE_API_KEY=...
# GOOGLE_BASE_URL=https://openrouter.ai/api/v1
# GOOGLE_MODEL=google/gemini-1.5-pro

# GitHub Configuration (Optional - for code mining)
GITHUB_TOKEN=ghp_...
GITHUB_SEARCH_LIMIT=5

# Hugging Face Configuration (Optional - for algorithm analysis)
ENABLE_HF_MODEL_SEARCH=false
HF_SEARCH_LIMIT=5
HF_TOKEN=

# System Configuration
LOG_LEVEL=INFO

# Execution Configuration
SANDBOX_TIMEOUT=30
MAX_FIX_ATTEMPTS=2

# Feature Flags
ENABLE_CODE_MEMORY=false
ENABLE_CODE_MINING=false
ENABLE_VISUAL_VERIFICATION=false
ENABLE_BDD_TESTING=true
