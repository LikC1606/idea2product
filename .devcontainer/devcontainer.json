{
  "name": "Idea2Product",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {},
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Idea2Product Web",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && pip install -e . && cp .env.example .env 2>/dev/null || true",
  "remoteEnv": {
    "HOST": "0.0.0.0",
    "PORT": "8080"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
